# ---- Server ----
# Public URL Twilio can reach (e.g. https://abcd.ngrok-free.app). Used for webhook callbacks + signature checks.
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=*
LOG_LEVEL=INFO
# Turn off text-driven test calls in production
ENABLE_SIMULATOR=true

# ---- Storage ----
# PostgreSQL: calls, transcripts, handoffs, agent profiles. The database and tables are created on first start.
# Cloud (Supabase / Neon): paste their connection string and add ?sslmode=require if it isn't there.
# Leave empty to keep everything in memory (lost on restart; dev only).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/agentic
# Redis: live AI state per call, the one-turn-at-a-time lock, and events shared between server processes.
# Upstash / Redis Cloud give a rediss:// URL (TLS). Needed to run more than one server process.
REDIS_URL=

# ---- Auth ----
# Agents sign in with Firebase (Google or email/password); the API checks their ID tokens for this project.
FIREBASE_PROJECT_ID=
# Optional shared secret for scripts / server-to-server calls (Authorization: Bearer <token>).
# With neither set, the API is open to anyone who can reach it: local development only.
API_TOKEN=
# Comma-separated emails that are always super admins. Otherwise the first person to sign up becomes the super admin.
SUPER_ADMIN_EMAILS=

# ---- Persona ----
COMPANY_NAME=Acme Support
CALL_LANGUAGE=en-IN
TTS_VOICE=Polly.Aditi

# ---- Claude ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low = fastest replies on a phone call
CLAUDE_EFFORT=low
AGENT_TURN_TIMEOUT_S=12

# ---- Handoff policy ----
MAX_FAILED_TURNS=3
MAX_AI_TURNS=15
MAX_TOOL_FAILURES=2
HOLD_TIMEOUT_S=120

# ---- Outbound calls (the app's Call tab) ----
# elevenlabs, valuefirst or twilio
CALL_PROVIDER=elevenlabs
# ValueFirst (Infinito): API token, and the voice campaign (set up in the ValueFirst portal) each call triggers
VALUEFIRST_API_TOKEN=
VALUEFIRST_CAMPAIGN_ID=

# ---- ElevenLabs Agents (the phone agent: speech, AI and calls) ----
# Create the agent at elevenlabs.io → Agents, and import a Twilio or SIP trunk phone number into it.
# The secret API key (starts with sk_). Not the key's ID.
ELEVEN_LABS_API_KEY=
ELEVEN_LABS_AGENT_ID=
# The agent's phone number: its phnum_ id, or the number itself
ELEVEN_LABS_CALLER_ID=
# Agents → Settings → Webhooks: URL {PUBLIC_BASE_URL}/elevenlabs/webhook, then paste its secret here
ELEVEN_LABS_WEBHOOKS_SECRET=
# https://api.in.residency.elevenlabs.io if your workspace has India data residency
ELEVEN_LABS_API_URL=https://api.elevenlabs.io

# ---- Twilio ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
VALIDATE_TWILIO_SIGNATURE=true
