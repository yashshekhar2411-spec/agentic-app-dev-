# Only EXPO_PUBLIC_* vars reach the app, and they are baked into the build. Never put secrets here.
# Default backend URL. 10.0.2.2 is your PC as seen from the Android emulator.
# On a real phone use your PC's LAN IP (e.g. http://192.168.1.20:8000) or change it in the app's Settings tab.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# Firebase (project agentic-app-f376c). Public identifiers, not secrets: access is enforced by Firebase Auth rules.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_SENDER_ID=
# Firebase console -> Authentication -> Sign-in method -> Google -> Web SDK configuration -> Web client ID
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
